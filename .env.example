# ==========================================================================
# 环境变量样例 —— 复制为 .env 后按需修改，.env 不会提交到仓库
#
# 优先级：内置默认值 < config/config.yaml < 环境变量
# 因此这里设置的项会覆盖 config.yaml 中的同名配置。
# ==========================================================================

# ---- 应用 ----
APP_NAME=go-backend
APP_MODE=debug                 # debug | release | test
APP_PORT=8080
APP_UPLOAD_DIR=./data/uploads
APP_CORS_ORIGINS=*             # 逗号分隔；生产环境请填前端域名
DOCS_ENABLED=false             # /docs 与 /openapi.json；本地开发设 true，生产留 false

# ---- JWT（必须修改，长度 >= 32，否则拒绝启动）----
# 生成方式：openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-0123456789
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=168h

# ---- 日志 ----
LOG_LEVEL=info                 # debug | info | warn | error
LOG_FORMAT=console             # console | json
LOG_FILE=                      # 留空则只输出到标准输出

# ---- 数据库 ----
# 选项一：SQLite（默认，零依赖，适合单机与开发）
DB_DRIVER=sqlite
DB_DSN=./data/app.db

# 选项二：PostgreSQL（生产推荐，注释上面两行改用下面两行）
# DB_DRIVER=postgres
# DB_DSN=host=127.0.0.1 user=postgres password=postgres dbname=gobackend port=5432 sslmode=disable TimeZone=Asia/Shanghai

# ---- Redis（二期启用）----
REDIS_ENABLED=false
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
