# ==========================================================================
# Docker 构建上下文排除清单
#
# 目的有两个：
#   1. 减小构建上下文体积（bin/ 里已经有 90MB 的本地二进制，
#      不排除的话每次 build 都要把它传给 daemon）
#   2. 避免把本地密钥、数据库、IDE 配置打进镜像
#
# 注意：这里排除的是"进不进镜像"，与 .gitignore（"提不提交到仓库"）是两件事，
# 所以两者内容有重叠但不等同 —— 例如 config/config.yaml 要进镜像（作为默认配置），
# 但不能排除它。
# ==========================================================================

# ---- 构建产物 / 运行期数据 ----
bin/
dist/
*.exe
*.exe~
*.test
*.out
coverage.out
data/
logs/
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- 本地密钥与环境变量：绝对不能进镜像 ----
.env
.env.*
!.env.example
config/config.local.yaml
*.pem
*.key
id_rsa*

# ---- 版本控制与 CI 元数据 ----
.git/
.gitignore
.github/
.gitattributes

# ---- Claude Code 配置 ----
.claude/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo

# ---- 文档与本地脚本 ----
# *.md 不进镜像（镜像里看代码注释就够了）；CHANGELOG 之类的也不影响运行。
#
# 注意：docs/ 必须保留在构建上下文里 —— 它是编译期必需的 Go 源码包
#（OpenAPI 3.1 spec + Scalar UI），internal/router 直接 import 它，
# 排除掉会导致 `go build` 找不到包而构建失败。
*.md
scripts/

# ---- 依赖缓存（容器内会重新下载，且平台可能不同）----
vendor/

# ---- Docker 自身文件，避免"改 Dockerfile 导致缓存全失效" ----
Dockerfile
.dockerignore
compose.yaml
compose.*.yml
